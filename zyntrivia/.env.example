# Copy to .env and fill in. Never commit .env.

# --- Database (Supabase Postgres) ---
# Supabase dashboard > Connect > "Session pooler" URI (IPv4-compatible).
# Percent-encode special characters in the password.
DATABASE_URL=
# Supabase dashboard > Database > Settings > SSL configuration > Download certificate.
# Paste the PEM contents (multi-line in quotes, or one line with \n escapes).
DATABASE_CA_CERT=

# --- Payload ---
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
PAYLOAD_SECRET=

# --- Media storage (Supabase Storage, S3-compatible) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# --- Email (Resend) ---
RESEND_API_KEY=
# Sender for quote emails and admin password resets. The domain must be verified in Resend.
EMAIL_FROM_ADDRESS=hello@zyntrivia.com
# Inbox that receives new quote request notifications (defaults to the contact email in Site settings)
QUOTE_NOTIFY_TO=

# --- Spam protection (Cloudflare Turnstile) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret for /api/draft preview links
DRAFT_SECRET=
# Vercel sends this as a Bearer token on cron calls to /api/payload-jobs/run
# (scheduled publishing, lead retention). Long random string.
CRON_SECRET=

# --- Analytics (Plausible) ---
PLAUSIBLE_DOMAIN=
